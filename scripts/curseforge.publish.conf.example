# Config for scripts/publish-curseforge.sh
#
# Copy this file to "curseforge.publish.conf" (either next to this script,
# or in the repo root — the repo root takes priority) and fill it in.
# This file is plain bash, sourced by the script — no secrets belong here.
# Put CURSEFORGE_API_TOKEN in your shell environment or in a gitignored
# ".env.curseforge" file next to the config instead.

# Required. Find it on your project's CurseForge page under
# "About Project" > right sidebar, or in the URL of legacy.curseforge.com.
CF_PROJECT_ID=""

# Optional. Used only to print a direct link to the uploaded file.
CF_PROJECT_SLUG=""

# "owner/repo" on GitHub. Leave empty to auto-detect from the 'origin' remote.
# The jar is always pulled from this repo's GitHub Release for each tag being
# published — attach it first with: gh release upload <tag> <path-to-jar>
CF_GITHUB_REPO=""

# Space-separated CurseForge game-version names this file supports, sent as
# gameVersionNames. Leave empty to auto-detect PER TAG from that tag's own
# gradle.properties (read via `git show <tag>:gradle.properties`, not from
# the working tree) — so publishing a release with several loader/branch
# tags at once still gets each file's correct MC version. Only set this
# manually to force the same value for every tag in a run.
CF_MC_VERSIONS=""

# Space-separated mod loader names, e.g. "Forge", "Fabric", "NeoForge", "Quilt".
# Leave empty to auto-detect PER TAG from that tag's own build.gradle
# (net.minecraftforge.gradle / fabric-loom / net.neoforged / org.quiltmc.loom),
# same tag-content sourcing as CF_MC_VERSIONS above. Only set this manually
# to force the same value for every tag in a run.
CF_MOD_LOADERS=""

# Required. CurseForge's "Environment" tag(s) — separate from game version
# and mod loader, but still mandatory or the upload is rejected with
# errorCode 1021. Use "Client" for a client-side-only mod, "Server" for a
# server-side-only mod, or "Client Server" (space-separated, both tags) if
# it's needed on both sides.
CF_ENVIRONMENTS=""

# Optional extra names to add to gameVersionNames, e.g. "Java 17".
CF_EXTRA_VERSIONS=""

# release | beta | alpha. Can be overridden per run with --release-type.
CF_RELEASE_TYPE="release"

# Prefix stripped from the git tag to get the mod version (v1.2.3 -> 1.2.3).
CF_TAG_PREFIX="v"

# Extended-regex asset filenames to ignore when picking the jar off the
# GitHub Release (sources/dev builds etc, if you attach more than one asset).
# Leave empty to disable filtering.
CF_JAR_EXCLUDE_PATTERN="-(sources|dev|shadow|api)\.jar$"

# Where to pull the per-version changelog text from. The script looks for a
# "## <version>" heading (Keep a Changelog style) and takes everything up to
# the next "## " heading. Falls back to the git tag/commit message if not found.
CF_CHANGELOG_FILE="CHANGELOG.md"
CF_CHANGELOG_TYPE="markdown"

# Template for the file's display name on CurseForge.
# Placeholders: {mod_name} {version} {tag}
CF_DISPLAY_NAME_TEMPLATE="{mod_name}-{version}"

# Leave empty to auto-detect from gradle.properties' mod_name, falling back
# to the repo directory name.
CF_MOD_NAME=""

# Where to remember which tags were already published (repo-root relative).
# Keyed by CF_PROJECT_ID, so one state file is safe to reuse across configs.
CF_STATE_FILE=".curseforge-published.json"
